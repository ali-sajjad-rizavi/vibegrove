{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "jsx": "react-jsx"
  },
  "include": ["src/server/**/*", "src/shared/**/*", "src/bin/**/*"],
  "exclude": ["node_modules", "dist", "src/client"]
}
